# URL pública desta aplicação (usada somente em redirects internos autorizados).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Configurações públicas do Supabase. Nunca inclua service role no navegador.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Exclusivas de serviços confiáveis/Edge Functions. Não use prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
ASAAS_API_KEY=
NOTIFICATION_CRON_SECRET=
